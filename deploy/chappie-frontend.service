[Unit]
Description=CHAPPiE Frontend
After=network.target chappie-web.service
Wants=chappie-web.service

[Service]
User=bbecker
Group=bbecker
WorkingDirectory=/home/bbecker/CHAPPiE/frontend
Environment="PATH=/home/bbecker/.local/share/fnm/node-versions/v24.14.0/installation/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NODE_ENV=production"
ExecStart=/home/bbecker/.local/share/fnm/node-versions/v24.14.0/installation/bin/npm run preview -- --host 0.0.0.0 --port 4173
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
